# Copy to .env.local (never committed) and fill in. See README "Environment variables".

# --- Browser (safe to expose; prefixed VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key (safe in the browser)
VITE_VAPID_PUBLIC_KEY=

# --- Server only (Netlify Functions / Netlify env vars; never in front-end code) ---
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Shared secret: Supabase Cron sends it to the push function (also stored in Supabase Vault)
PUSH_SECRET=
NTFY_SERVER=https://ntfy.sh
EMAIL_API_KEY=

# --- Dev only (never set on Netlify) ---
# Written by `npm run dev:accounts`: the test accounts' password, and the dev-only password sign-in on npm run dev.
DEV_TEST_PASSWORD=
VITE_DEV_SIGN_IN=
