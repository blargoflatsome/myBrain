{
  "name": "my-brain",
  "private": true,
  "version": "0.1.0",
  "author": "Jordan Buermann (https://www.linkedin.com/in/jordanbuermann/)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=desktop-chromium",
    "test:quick": "npm run typecheck && npm run test && npm run test:e2e:quick",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "test:db": "node scripts/test-db.mjs",
    "dev:accounts": "node scripts/dev-accounts.mjs",
    "test:flows": "node scripts/test-flows.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "chrono-node": "2.10.3",
    "dexie": "^4.4.7",
    "dompurify": "3.4.17",
    "pinia": "^4.1.0",
    "sortablejs": "1.15.7",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "1.15.9",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "supabase": "^3.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
