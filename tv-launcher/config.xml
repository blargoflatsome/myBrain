<?xml version="1.0" encoding="UTF-8"?>
<!-- My Brain's TV launcher (docs/SPEC.md §9 The launcher). The site address is also in launcher.js: change both. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://myadhdbrain.netlify.app/tv" version="1.0.0" viewmodes="maximized">
  <tizen:application id="MyBrainTV1.MyBrain" package="MyBrainTV1" required_version="5.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>My Brain</name>
  <icon src="icon.png"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <!-- The TV page, and the server it talks to. -->
  <access origin="https://myadhdbrain.netlify.app" subdomains="true"/>
  <access origin="https://supabase.co" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/power"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
